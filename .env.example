NODE_ENV=development
API_PORT=4000

# Postgres — matches docker-compose.yml's `postgres` service
DATABASE_URL=postgresql://rfidcore:rfidcore@localhost:5432/rfidcore?schema=public

# Generate real values before any non-local deployment, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-random-32-plus-char-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-char-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_URL=redis://localhost:6379

CORS_ORIGIN=http://localhost:3000
# Production (comma-separated OK): https://your-app.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Production: https://your-api.onrender.com/api/v1

# Optional: object storage (MinIO locally, S3-compatible in prod) for file uploads
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Optional: enables the AI Sales Assistant / lead-scoring LLM calls
ANTHROPIC_API_KEY=

# Optional: outbound email for notifications. Unset = logs to console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ibTech <notifications@ibtechintl.com>

# Optional: always copy job lifecycle emails to this ops address
JOB_NOTIFY_CC=
