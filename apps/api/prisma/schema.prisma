// ============================================================================
// RFIDCore — Prisma Schema
// Covers all 25 modules. Every tenant-scoped table carries companyId/branchId.
// See docs/06-database-schema.md for the ERD narrative and docs/04-process-mapping.md
// for the state machines these models implement.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// 0. Platform: Companies, Branches, Users, RBAC, Audit, Notifications
// ----------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  taxId     String?
  currency  String   @default("AED") // ISO 4217 default company currency
  timezone  String   @default("Asia/Dubai")
  logoUrl   String?
  webhookToken String @unique @default(cuid()) // authenticates POST /public/leads — see modules/public
  leadAssignMode LeadAssignMode @default(MANUAL)
  roundRobinCursor Int @default(0)
  leadSlaHours Int @default(24)
  quoteChaseDays Int @default(7)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches      Branch[]
  users         User[]
  customers     Customer[]
  leads         Lead[]
  campaigns     Campaign[]
  products      Product[]
  priceLists    PriceList[]
  vendors       Vendor[]
  warehouses    Warehouse[]
  numberSeqs    NumberSequence[]
  slaPolicies   SlaPolicy[]
  auditLogs     AuditLog[]
  shiftHandovers ShiftHandoverNote[]

  @@map("companies")
}

model ShiftHandoverNote {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("shift_handover_notes")
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  code      String
  address   String?
  city      String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  warehouses Warehouse[]

  @@unique([companyId, code])
  @@map("branches")
}

enum RoleKey {
  SUPER_ADMIN
  MANAGING_DIRECTOR
  SALES_DIRECTOR
  SALES_MANAGER
  SALES_EXECUTIVE
  SALES_COORDINATOR
  PRE_SALES_ENGINEER
  TECHNICAL_CONSULTANT
  PROJECT_MANAGER
  IMPLEMENTATION_ENGINEER
  DELIVERY_PERSON
  SUPPORT_ENGINEER
  FINANCE
  ACCOUNTS
  WAREHOUSE
  PROCUREMENT
  CUSTOMER_PORTAL_USER
}

enum LeadAssignMode {
  MANUAL
  ROUND_ROBIN
}

model Role {
  id          String   @id @default(cuid())
  key         RoleKey  @unique
  name        String
  description String?
  isSystem    Boolean  @default(true) // system roles cannot be deleted, only permission-edited
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "lead:create", "quotation:override_price", "settings:manage_roles"
  module      String  // e.g. "lead", "quotation" — matches module folder names
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id])
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  firstName    String
  lastName     String
  email        String     @unique
  phone        String?
  passwordHash         String
  status               UserStatus @default(ACTIVE)
  avatarUrl            String?
  emailNotifications   Boolean    @default(true)
  // Only set for CUSTOMER_PORTAL_USER role — scopes every portal query to this
  // one customer account. Null for every internal-staff role.
  customerId           String?
  portalCustomer       Customer?  @relation("PortalUser", fields: [customerId], references: [id])
  passwordResetToken   String?
  passwordResetExpires DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  refreshTokens        RefreshToken[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  assignedLeads          Lead[]              @relation("LeadOwner")
  ownedCustomers          Customer[]          @relation("CustomerOwner")
  ownedOpportunities      Opportunity[]       @relation("OpportunityOwner")
  activities              Activity[]          @relation("ActivityActor")
  calendarEvents          CalendarEvent[]     @relation("CalendarOwner")
  quotationsCreated       Quotation[]         @relation("QuotationCreator")
  approvalsRequested      Approval[]          @relation("ApprovalRequester")
  approvalsDecided        Approval[]          @relation("ApprovalDecider")
  managedProjects         Project[]           @relation("ProjectManager")
  engineerTasks           EngineerTask[]      @relation("TaskAssignee")
  tasksCreated            EngineerTask[]      @relation("TaskCreator")
  tasksVerified           EngineerTask[]      @relation("TaskVerifier")
  supportTicketsAssigned  Ticket[]            @relation("TicketAssignee")
  supportTicketsRaised    Ticket[]            @relation("TicketRaisedBy")
  shiftHandovers          ShiftHandoverNote[]

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdByIp String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  entityType String   // e.g. "Quotation"
  entityId   String
  action     String   // CREATE | UPDATE | DELETE | APPROVE | REJECT | STAGE_CHANGE ...
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([companyId, entityType, entityId])
  @@map("audit_logs")
}

enum NotificationType {
  ASSIGNMENT
  APPROVAL_REQUEST
  APPROVAL_DECISION
  SLA_RISK
  SLA_BREACH
  AMC_RENEWAL
  INVOICE_OVERDUE
  STAGE_REGRESSION
  MENTION
  SYSTEM
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

// Generic sequence generator for human-friendly numbers: LEAD-2026-0001, QT-2026-0001, INV-2026-0001 ...
model NumberSequence {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String   // "QUOTATION", "INVOICE", "PROJECT", "TICKET", "SUPPLIER_PO", "CUSTOMER_PO", "SALES_ORDER"
  year      Int
  lastValue Int      @default(0)

  @@unique([companyId, key, year])
  @@map("number_sequences")
}

// ----------------------------------------------------------------------------
// 1. Lead Management
// ----------------------------------------------------------------------------

enum LeadSource {
  WEBSITE
  REFERRAL
  COLD_CALL
  EXHIBITION
  PARTNER
  SOCIAL_MEDIA
  EMAIL_CAMPAIGN
  INBOUND_CALL
  EMAIL
  WHATSAPP
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum Industry {
  RETAIL
  LUXURY
  FASHION
  HEALTHCARE
  PHARMACEUTICALS
  WAREHOUSING
  MANUFACTURING
  GOVERNMENT
  LOGISTICS
  EDUCATION
  HOSPITALITY
  OTHER
}

enum DisqualifyReason {
  BUDGET
  TIMING
  NO_AUTHORITY
  NOT_INTERESTED
  COMPETITOR
  OTHER
}

model Campaign {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  channel   String   // e.g. "Exhibition - GITEX", "Google Ads", "Email Blast Q3"
  startDate DateTime?
  endDate   DateTime?
  budget    Decimal? @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  leads Lead[]

  @@index([companyId])
  @@map("campaigns")
}

model Lead {
  id                  String            @id @default(cuid())
  companyId           String
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId            String?
  code                String            // LEAD-2026-0001
  campaignId          String?
  campaign            Campaign?         @relation(fields: [campaignId], references: [id])
  companyName         String
  contactName         String
  email                String?
  phone                String?
  source               LeadSource
  industry             Industry
  status               LeadStatus        @default(NEW)
  score                Int               @default(0) // AI lead score 0-100
  scoreUpdatedAt       DateTime?
  ownerId              String?
  owner                User?             @relation("LeadOwner", fields: [ownerId], references: [id])
  disqualifyReason     DisqualifyReason?
  disqualifyNote       String?
  convertedOpportunityId String?         @unique
  convertedOpportunity Opportunity?      @relation("LeadToOpportunity", fields: [convertedOpportunityId], references: [id])
  notes                String?
  internalNotes        String?           // coordinator-only; never on customer-facing exports
  firstContactedAt     DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  activities Activity[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, ownerId])
  @@map("leads")
}

// ----------------------------------------------------------------------------
// 2. Customer & Contact Management
// ----------------------------------------------------------------------------

model Customer {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    String?
  code        String     // CUST-0001
  name        String
  industry    Industry
  website     String?
  taxId       String?
  ownerId     String?
  owner       User?      @relation("CustomerOwner", fields: [ownerId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  contacts      Contact[]
  sites         Site[]
  opportunities Opportunity[]
  quotations    Quotation[]
  customerPOs   CustomerPO[]
  salesOrders   SalesOrder[]
  projects      Project[]
  invoices      Invoice[]
  tickets       Ticket[]
  amcContracts  AmcContract[]
  activities    Activity[]
  portalUsers   User[]        @relation("PortalUser")

  @@unique([companyId, code])
  @@map("customers")
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  title      String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("contacts")
}

model Site {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   // "Main Warehouse", "Flagship Store - Dubai Mall"
  addressLine String?
  city       String?
  country    String?
  geoLat     Float?
  geoLng     Float?
  createdAt  DateTime @default(now())

  siteSurveys  SiteSurvey[]
  projects     Project[]
  devices      Device[]

  @@map("sites")
}

// ----------------------------------------------------------------------------
// 3+4+7+8. Opportunity, Pipeline, Activity Timeline, Calendar/Follow-ups
// ----------------------------------------------------------------------------

enum OpportunityStage {
  REQUIREMENT_GATHERING
  SITE_SURVEY
  TECHNICAL_DISCUSSION
  INTERNAL_REVIEW
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

enum LossReason {
  PRICE
  COMPETITOR
  TIMING
  BUDGET
  NO_DECISION
  TECHNICAL_FIT
  OTHER
}

model Opportunity {
  id                String            @id @default(cuid())
  companyId         String
  branchId          String?
  code              String            // OPP-2026-0001
  title             String
  customerId        String
  customer          Customer          @relation(fields: [customerId], references: [id])
  ownerId           String?
  owner             User?             @relation("OpportunityOwner", fields: [ownerId], references: [id])
  stage             OpportunityStage  @default(REQUIREMENT_GATHERING)
  probability        Int              @default(10) // %
  estimatedValue      Decimal         @db.Decimal(14, 2)
  currency            String          @default("AED")
  expectedCloseDate   DateTime?
  lossReason          LossReason?
  lossNote             String?
  competitor           String?
  internalNotes        String?
  createdAt            DateTime        @default(now())
  updatedAt             DateTime       @updatedAt
  wonAt                 DateTime?
  lostAt                 DateTime?

  leadSource        Lead?             @relation("LeadToOpportunity")
  stageHistory      OpportunityStageHistory[]
  siteSurveys       SiteSurvey[]
  demos             DemoRecord[]
  pocs              PocRecord[]
  solutionDesigns   SolutionDesign[]
  quotations        Quotation[]
  activities        Activity[]
  calendarEvents    CalendarEvent[]
  customerPOs       CustomerPO[]
  projects          Project[]

  @@unique([companyId, code])
  @@index([companyId, stage])
  @@index([companyId, ownerId])
  @@map("opportunities")
}

model OpportunityStageHistory {
  id            String           @id @default(cuid())
  opportunityId String
  opportunity   Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage     OpportunityStage?
  toStage       OpportunityStage
  changedById   String?
  enteredAt     DateTime         @default(now())
  isRegression  Boolean          @default(false)

  @@map("opportunity_stage_history")
}

model SiteSurvey {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  siteId        String?
  site          Site?       @relation(fields: [siteId], references: [id])
  conductedById String?
  surveyDate    DateTime
  findings      String?
  attachments   Json?       // array of {name, url}
  createdAt     DateTime    @default(now())

  @@map("site_surveys")
}

model DemoRecord {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  demoDate      DateTime
  productsShown String?
  outcome       String?
  conductedById String?
  createdAt     DateTime    @default(now())

  @@map("demo_records")
}

model PocRecord {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime?
  scope         String?
  successCriteria String?
  outcome       String?
  createdAt     DateTime    @default(now())

  @@map("poc_records")
}

model SolutionDesign {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  bom           Json?       // bill of materials draft: [{productId, qty, notes}]
  attachments   Json?
  createdById   String?
  createdAt     DateTime    @default(now())

  @@map("solution_designs")
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  SITE_VISIT
  STAGE_CHANGE
  DOCUMENT
  SYSTEM
}

// Unified activity timeline attachable to Lead, Customer, or Opportunity
model Activity {
  id            String        @id @default(cuid())
  companyId     String
  type          ActivityType
  subject       String
  body          String?
  actorId       String?
  actor         User?         @relation("ActivityActor", fields: [actorId], references: [id])
  leadId        String?
  lead          Lead?         @relation(fields: [leadId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  opportunityId String?
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id])
  durationMins  Int?
  occurredAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())

  @@index([leadId])
  @@index([customerId])
  @@index([opportunityId])
  @@map("activities")
}

enum CalendarEventType {
  FOLLOW_UP
  MEETING
  SITE_VISIT
  DEMO
  INSTALLATION
  TRAINING
  OTHER
}

model CalendarEvent {
  id            String            @id @default(cuid())
  companyId     String
  ownerId       String
  owner         User              @relation("CalendarOwner", fields: [ownerId], references: [id])
  type          CalendarEventType
  title         String
  startAt       DateTime
  endAt         DateTime?
  opportunityId String?
  opportunity   Opportunity?      @relation(fields: [opportunityId], references: [id])
  completedAt   DateTime?
  reminderAt    DateTime?
  createdAt     DateTime          @default(now())

  @@index([ownerId, startAt])
  @@map("calendar_events")
}

// ----------------------------------------------------------------------------
// 9. Quotation Management
// ----------------------------------------------------------------------------

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED_INTERNAL
  SENT
  CUSTOMER_APPROVED
  CUSTOMER_REJECTED
  REVISION_REQUESTED
  SUPERSEDED
  EXPIRED
}

model Quotation {
  id             String          @id @default(cuid())
  companyId      String
  branchId       String?
  code           String          // QT-2026-0001
  version        Int             @default(1)
  parentQuotationId String?
  parentQuotation Quotation?     @relation("QuotationRevision", fields: [parentQuotationId], references: [id])
  revisions      Quotation[]     @relation("QuotationRevision")
  opportunityId  String
  opportunity    Opportunity     @relation(fields: [opportunityId], references: [id])
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])
  status         QuotationStatus @default(DRAFT)
  currency       String          @default("AED")
  subtotal       Decimal         @db.Decimal(14, 2) @default(0)
  discountTotal  Decimal         @db.Decimal(14, 2) @default(0)
  taxTotal       Decimal         @db.Decimal(14, 2) @default(0)
  grandTotal     Decimal         @db.Decimal(14, 2) @default(0)
  paymentTerms   String?         // "40% advance / 40% on delivery / 20% on go-live"
  validUntil     DateTime?
  createdById    String
  createdBy      User            @relation("QuotationCreator", fields: [createdById], references: [id])
  sentAt         DateTime?
  decidedAt      DateTime?
  revisionNote   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  lineItems   QuotationLineItem[]
  approvals   Approval[]
  customerPOs CustomerPO[]

  @@unique([companyId, code, version])
  @@index([companyId, status])
  @@map("quotations")
}

model QuotationLineItem {
  id            String    @id @default(cuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id])
  description   String
  quantity      Decimal   @db.Decimal(12, 2)
  unitPrice     Decimal   @db.Decimal(14, 2)
  listPrice     Decimal?  @db.Decimal(14, 2) // catalog price at time of quoting, for override audit
  discountPct   Decimal   @db.Decimal(5, 2)  @default(0)
  taxPct        Decimal   @db.Decimal(5, 2)  @default(0)
  lineTotal     Decimal   @db.Decimal(14, 2)
  isPriceOverridden Boolean @default(false)
  overrideReason String?
  sortOrder     Int       @default(0)

  @@map("quotation_line_items")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Generic approval used by Quotation (discount/price override), CustomerPO reconciliation, etc.
model Approval {
  id            String         @id @default(cuid())
  companyId     String
  entityType    String         // "Quotation"
  entityId      String
  quotationId   String?
  quotation     Quotation?     @relation(fields: [quotationId], references: [id])
  requestedById String
  requestedBy   User           @relation("ApprovalRequester", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?          @relation("ApprovalDecider", fields: [decidedById], references: [id])
  status        ApprovalStatus @default(PENDING)
  reason        String?        // why approval was triggered (e.g. "Discount 22% > 20% threshold")
  comment       String?        // decision comment
  requestedAt   DateTime       @default(now())
  decidedAt     DateTime?

  @@index([companyId, status])
  @@map("approvals")
}

// ----------------------------------------------------------------------------
// 10+11. Purchase Order (customer) + Sales Order Management
// ----------------------------------------------------------------------------

enum CustomerPOStatus {
  RECEIVED
  VERIFIED
  DISPUTED
  CANCELLED
}

model CustomerPO {
  id            String           @id @default(cuid())
  companyId     String
  branchId      String?
  code          String           // CPO-2026-0001
  poNumber      String           // customer's own PO number
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  opportunityId String?
  opportunity   Opportunity?     @relation(fields: [opportunityId], references: [id])
  quotationId   String
  quotation     Quotation        @relation(fields: [quotationId], references: [id])
  amount        Decimal          @db.Decimal(14, 2)
  currency      String           @default("AED")
  status        CustomerPOStatus @default(RECEIVED)
  documentUrl   String?          // uploaded scanned PO, versioned via FileAsset
  amountMismatch Boolean         @default(false)
  advanceRequired Decimal        @db.Decimal(14, 2) @default(0)
  advanceReceivedAt DateTime?
  receivedAt    DateTime         @default(now())
  createdAt     DateTime         @default(now())

  salesOrder SalesOrder?

  @@unique([companyId, code])
  @@map("customer_pos")
}

enum SalesOrderStatus {
  PENDING_ALLOCATION
  PARTIALLY_ALLOCATED
  ALLOCATED
  FULFILLED
  CANCELLED
}

model SalesOrder {
  id            String           @id @default(cuid())
  companyId     String
  branchId      String?
  code          String           // SO-2026-0001
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  customerPOId  String           @unique
  customerPO    CustomerPO       @relation(fields: [customerPOId], references: [id])
  status        SalesOrderStatus @default(PENDING_ALLOCATION)
  currency      String           @default("AED")
  totalAmount   Decimal          @db.Decimal(14, 2)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  lineItems   SalesOrderLineItem[]
  allocations InventoryAllocation[]
  project     Project?
  invoices    Invoice[]

  @@unique([companyId, code])
  @@map("sales_orders")
}

model SalesOrderLineItem {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Decimal    @db.Decimal(12, 2)
  unitPrice    Decimal    @db.Decimal(14, 2)
  lineTotal    Decimal    @db.Decimal(14, 2)

  allocations InventoryAllocation[]

  @@map("sales_order_line_items")
}

// ----------------------------------------------------------------------------
// 12+13+14. Inventory & Product Catalog, Warehouse, Procurement
// ----------------------------------------------------------------------------

enum ProductCategory {
  RFID_READER
  RFID_ANTENNA
  RFID_GATE
  RFID_HANDHELD
  RFID_PRINTER
  RFID_TAG
  RFID_LABEL
  RFID_SOFTWARE
  LOSS_PREVENTION
  EAS_SYSTEM
  MARKING_CODING
  BARCODE
  WAREHOUSE_AUTOMATION
  ASSET_TRACKING
  CLOUD_LICENSE
  SERVICE_INSTALLATION
  SERVICE_TRAINING
  SERVICE_AMC
  OTHER
}

model Product {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sku          String
  name         String
  category     ProductCategory
  brand        String?
  description  String?
  unit         String          @default("PCS")
  costPrice    Decimal         @db.Decimal(14, 2) @default(0)
  basePrice    Decimal         @db.Decimal(14, 2) // default sell price
  currency     String          @default("AED")
  isSerialized Boolean         @default(false) // true for devices tracked by serial (readers, gates, printers)
  reorderLevel Decimal         @db.Decimal(12, 2) @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  stockItems       StockItem[]
  priceListItems   PriceListItem[]
  quotationLines   QuotationLineItem[]
  salesOrderLines  SalesOrderLineItem[]
  supplierPOLines  SupplierPOLineItem[]
  devices          Device[]

  @@unique([companyId, sku])
  @@index([companyId, category])
  @@map("products")
}

model PriceList {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String   // "Retail Standard", "Government GSA", "Partner Wholesale"
  currency  String   @default("AED")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  items PriceListItem[]

  @@map("price_lists")
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  price       Decimal   @db.Decimal(14, 2)

  @@unique([priceListId, productId])
  @@map("price_list_items")
}

model Warehouse {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  name      String
  code      String
  address   String?
  createdAt DateTime @default(now())

  stockItems StockItem[]

  @@unique([companyId, code])
  @@map("warehouses")
}

model StockItem {
  id           String    @id @default(cuid())
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  onHandQty    Decimal   @db.Decimal(12, 2) @default(0)
  reservedQty  Decimal   @db.Decimal(12, 2) @default(0)
  updatedAt    DateTime  @updatedAt

  movements StockMovement[]

  @@unique([warehouseId, productId])
  @@map("stock_items")
}

enum StockMovementType {
  RECEIPT
  ISSUE
  ALLOCATION_RESERVE
  ALLOCATION_RELEASE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

model StockMovement {
  id          String            @id @default(cuid())
  stockItemId String
  stockItem   StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 2)
  reference   String?           // e.g. SalesOrder code, SupplierPO code
  note        String?
  createdById String?
  createdAt   DateTime          @default(now())

  @@map("stock_movements")
}

// Reserves SalesOrderLineItem quantity against a StockItem
model InventoryAllocation {
  id                   String             @id @default(cuid())
  salesOrderId         String
  salesOrder           SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  salesOrderLineItemId String
  salesOrderLineItem   SalesOrderLineItem @relation(fields: [salesOrderLineItemId], references: [id], onDelete: Cascade)
  warehouseId          String
  quantity             Decimal            @db.Decimal(12, 2)
  status               String             @default("RESERVED") // RESERVED | ISSUED | RELEASED
  createdAt            DateTime           @default(now())

  @@map("inventory_allocations")
}

model Vendor {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  contactName String?
  email     String?
  phone     String?
  leadTimeDays Int?  @default(14)
  createdAt DateTime @default(now())

  supplierPOs SupplierPO[]

  @@map("vendors")
}

enum SupplierPOStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model SupplierPO {
  id        String           @id @default(cuid())
  companyId String
  branchId  String?
  code      String           // SPO-2026-0001
  vendorId  String
  vendor    Vendor           @relation(fields: [vendorId], references: [id])
  status    SupplierPOStatus @default(DRAFT)
  currency  String           @default("AED")
  totalAmount Decimal        @db.Decimal(14, 2) @default(0)
  expectedDate DateTime?
  triggeredBySalesOrderId String? // links back if auto-suggested from a stock shortfall
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  lineItems SupplierPOLineItem[]
  receipts  GoodsReceipt[]

  @@unique([companyId, code])
  @@map("supplier_pos")
}

model SupplierPOLineItem {
  id           String     @id @default(cuid())
  supplierPOId String
  supplierPO   SupplierPO @relation(fields: [supplierPOId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Decimal    @db.Decimal(12, 2)
  unitCost     Decimal    @db.Decimal(14, 2)
  receivedQty  Decimal    @db.Decimal(12, 2) @default(0)

  @@map("supplier_po_line_items")
}

model GoodsReceipt {
  id           String     @id @default(cuid())
  supplierPOId String
  supplierPO   SupplierPO @relation(fields: [supplierPOId], references: [id])
  receivedById String?
  variance     Json?      // [{productId, expectedQty, receivedQty}]
  createdAt    DateTime   @default(now())

  @@map("goods_receipts")
}

// ----------------------------------------------------------------------------
// 15+16+17+18. RFID Project Management, Installation, Device, Engineer Tasks
// ----------------------------------------------------------------------------

enum ProjectStatus {
  CREATED
  ENGINEER_ASSIGNED
  INSTALLATION_IN_PROGRESS
  INSTALLATION_COMPLETE
  CONFIGURATION_COMPLETE
  TESTING_COMPLETE
  TRAINING_COMPLETE
  GO_LIVE
  CLOSED
  ON_HOLD
}

model Project {
  id           String        @id @default(cuid())
  companyId    String
  branchId     String?
  code         String        // PRJ-2026-0001
  name         String
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  siteId       String?
  site         Site?         @relation(fields: [siteId], references: [id])
  opportunityId String?
  opportunity  Opportunity?  @relation(fields: [opportunityId], references: [id])
  salesOrderId String        @unique
  salesOrder   SalesOrder    @relation(fields: [salesOrderId], references: [id])
  managerId    String?
  manager      User?         @relation("ProjectManager", fields: [managerId], references: [id])
  status       ProjectStatus @default(CREATED)
  plannedGoLiveDate DateTime?
  actualGoLiveDate  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  milestones ProjectMilestone[]
  tasks      EngineerTask[]
  devices    Device[]
  invoices   Invoice[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("projects")
}

enum MilestoneKey {
  ENGINEER_ASSIGNMENT
  INSTALLATION
  CONFIGURATION
  TESTING
  TRAINING
  GO_LIVE
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  BLOCKED
}

model ProjectMilestone {
  id         String          @id @default(cuid())
  projectId  String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key        MilestoneKey
  status     MilestoneStatus @default(PENDING)
  ownerId    String?
  dueDate    DateTime?
  completedAt DateTime?
  evidence   Json?           // [{name, url, type: photo|checklist|signature}]
  notes      String?

  @@unique([projectId, key])
  @@map("project_milestones")
}

enum TaskStatus {
  TODO
  SEEN
  IN_PROGRESS
  SUBMITTED
  BLOCKED
  DONE
}

enum TaskJobType {
  DELIVERY
  CHEQUE_COLLECTION
  DOCUMENT_PICKUP
  SITE_VISIT
  INSTALLATION
  EXPORT_SHIPMENT
  IMPORT_RECEIVING
  OTHER
}

model EngineerTask {
  id                  String         @id @default(cuid())
  companyId           String
  projectId           String?
  project             Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById         String?
  createdBy           User?          @relation("TaskCreator", fields: [createdById], references: [id])
  assigneeId          String?
  assignee            User?          @relation("TaskAssignee", fields: [assigneeId], references: [id])
  verifiedById        String?
  verifiedBy          User?          @relation("TaskVerifier", fields: [verifiedById], references: [id])
  title               String
  description         String?
  jobType             TaskJobType    @default(OTHER)
  status              TaskStatus     @default(TODO)
  dueDate             DateTime?
  scheduleOrder       Int?
  seenAt              DateTime?
  submittedAt         DateTime?
  verifiedAt          DateTime?
  completedAt         DateTime?
  completionNote      String?
  paymentAmount       Decimal?       @db.Decimal(14, 2)
  paymentMethod       PaymentMethod?
  paymentReference    String?
  /// Field SOP checklists: { preDay, warehouse, visit, docs, eod }
  sopChecklist        Json?
  /// Packing DO details: item counts, weights, pallets
  packingDetails      Json?
  customerNotifiedAt  DateTime?
  incompleteReason    String?
  rescheduleDate      DateTime?
  originalsReturnedAt DateTime?
  isOfflineSynced     Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([assigneeId, status])
  @@index([createdById, status])
  @@index([assigneeId, dueDate])
  @@map("engineer_tasks")
}

enum DeviceType {
  READER
  ANTENNA
  GATE
  HANDHELD
  PRINTER
  TAG
  LABEL_APPLICATOR
  EAS_SYSTEM
  OTHER
}

enum DeviceStatus {
  IN_STOCK
  ALLOCATED
  INSTALLED
  FAULTY
  RETIRED
  RMA
}

model Device {
  id           String       @id @default(cuid())
  companyId    String
  productId    String
  product      Product      @relation(fields: [productId], references: [id])
  serialNumber String
  type         DeviceType
  status       DeviceStatus @default(IN_STOCK)
  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id])
  siteId       String?
  site         Site?        @relation(fields: [siteId], references: [id])
  location     String?      // e.g. "Entrance Gate 2, Ground Floor"
  firmwareVersion String?
  configuration Json?
  installedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tickets      Ticket[]
  amcDevices   AmcContractDevice[]

  @@unique([companyId, serialNumber])
  @@map("devices")
}

// ----------------------------------------------------------------------------
// 19. Finance (Invoices, Payments, Receipts)
// ----------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id           String        @id @default(cuid())
  companyId    String
  branchId     String?
  code         String        // INV-2026-0001
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  salesOrderId String?
  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id])
  milestoneLabel String?     // "Advance", "Delivery", "Go-Live" for milestone invoicing
  status       InvoiceStatus @default(DRAFT)
  currency     String        @default("AED")
  subtotal     Decimal       @db.Decimal(14, 2)
  taxTotal     Decimal       @db.Decimal(14, 2) @default(0)
  totalAmount  Decimal       @db.Decimal(14, 2)
  amountPaid   Decimal       @db.Decimal(14, 2) @default(0)
  dueDate      DateTime
  issuedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(12, 2) @default(1)
  unitPrice   Decimal @db.Decimal(14, 2)
  taxPct      Decimal @db.Decimal(5, 2) @default(0)
  lineTotal   Decimal @db.Decimal(14, 2)

  @@map("invoice_line_items")
}

enum PaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  CARD
  ONLINE
}

model Payment {
  id            String        @id @default(cuid())
  companyId     String
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(14, 2)
  currency      String        @default("AED")
  method        PaymentMethod
  reference     String?       // cheque no / txn id
  receivedAt    DateTime      @default(now())
  recordedById  String?
  createdAt     DateTime      @default(now())

  @@map("payments")
}

// ----------------------------------------------------------------------------
// 20. Support Ticketing
// ----------------------------------------------------------------------------

enum TicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
  ESCALATED
}

model SlaPolicy {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priority      TicketPriority
  responseMins  Int            // time to first response
  resolutionMins Int           // time to resolution

  @@unique([companyId, priority])
  @@map("sla_policies")
}

model Ticket {
  id           String         @id @default(cuid())
  companyId    String
  branchId     String?
  code         String         // TCK-2026-0001
  customerId   String
  customer     Customer       @relation(fields: [customerId], references: [id])
  deviceId     String?
  device       Device?        @relation(fields: [deviceId], references: [id])
  subject      String
  description  String?
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(NEW)
  raisedById   String?
  raisedBy     User?          @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  assigneeId   String?
  assignee     User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  slaResponseDueAt   DateTime?
  slaResolutionDueAt DateTime?
  resolvedAt   DateTime?
  resolutionNote String?
  reopenCount  Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  comments TicketComment[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("tickets")
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  body      String
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())

  @@map("ticket_comments")
}

// ----------------------------------------------------------------------------
// 21. AMC & Contract Management
// ----------------------------------------------------------------------------

enum AmcStatus {
  ACTIVE
  EXPIRING_SOON
  LAPSED
  RENEWED
  CANCELLED
}

model AmcContract {
  id           String    @id @default(cuid())
  companyId    String
  branchId     String?
  code         String    // AMC-2026-0001
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  status       AmcStatus @default(ACTIVE)
  currency     String    @default("AED")
  contractValue Decimal  @db.Decimal(14, 2)
  startDate    DateTime
  endDate      DateTime
  renewedFromId String?  @unique
  renewedFrom  AmcContract? @relation("AmcRenewal", fields: [renewedFromId], references: [id])
  renewedTo    AmcContract? @relation("AmcRenewal")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  devices AmcContractDevice[]

  @@unique([companyId, code])
  @@index([companyId, status, endDate])
  @@map("amc_contracts")
}

model AmcContractDevice {
  id            String      @id @default(cuid())
  amcContractId String
  amcContract   AmcContract @relation(fields: [amcContractId], references: [id], onDelete: Cascade)
  deviceId      String
  device        Device      @relation(fields: [deviceId], references: [id])

  @@unique([amcContractId, deviceId])
  @@map("amc_contract_devices")
}

// ----------------------------------------------------------------------------
// Shared: File assets (versioned uploads referenced from many modules)
// ----------------------------------------------------------------------------

model FileAsset {
  id          String   @id @default(cuid())
  companyId   String
  entityType  String   // "CustomerPO", "SiteSurvey", "ProjectMilestone" ...
  entityId    String
  fileName    String
  url         String
  mimeType    String?
  sizeBytes   Int?
  version     Int      @default(1)
  uploadedById String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("file_assets")
}
